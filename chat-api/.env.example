# Copy this file to .env and fill these values from your Microsoft Foundry deployment.
# Keep .env private. Never put the API key in browser JavaScript or commit it to Git.
AZURE_FOUNDRY_ENDPOINT=https://YOUR-RESOURCE-NAME.services.ai.azure.com/api/projects/YOUR-PROJECT-NAME
AZURE_FOUNDRY_API_KEY=replace-with-your-key
AZURE_FOUNDRY_MODEL=your-model-deployment-name

PORT=8081
